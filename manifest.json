{
  "manifest_version": 3,
  "name": "Router Monitor",
  "version": "2.7.0",
  "description": "Monitor speed and signal on Dialog ZLT P11 and Huawei HiLink B310 routers.",
  "permissions": [
    "storage",
    "notifications",
    "alarms",
    "offscreen"
  ],
  "host_permissions": [
    "http://192.168.8.1/*"
  ],
  "optional_host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Router Monitor",
    "default_popup": "popup.html",
    "default_icon": {
      "128": "icon128.png"
    }
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "icons": {
    "128": "icon128.png"
  },
  "minimum_chrome_version": "124"
}
